// Museo data model (PostgreSQL — works with Neon / Vercel Postgres / Supabase / any Postgres).
// DATABASE_URL: runtime connection (use the *pooled* URL on serverless).
// DIRECT_URL:   direct (non-pooled) connection used by `prisma migrate`. Set it equal to DATABASE_URL if you have no pooler.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  username             String   @unique
  displayName          String
  bio                  String   @default("")
  avatarUrl            String?
  socialLinks          Json     @default("[]")
  passwordHash         String
  // Billing
  subscribed           Boolean  @default(false)
  subscriptionStatus   String   @default("none") // none | active | past_due | canceled | demo
  // Privacy: "request" = new followers need approval (default); "open" = anyone can follow
  followPolicy         String   @default("request")
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sessions  Session[]
  pages     Page[]
  items     Item[]
  likes     ItemLike[]
  comments  ItemComment[]
  reactions CommentReaction[]
  following Follow[]          @relation("follower")
  followers Follow[]          @relation("following")

  sentFollowRequests     FollowRequest[]      @relation("requester")
  receivedFollowRequests FollowRequest[]      @relation("requestTarget")
  notifications          Notification[]       @relation("recipient")
  actedNotifications     Notification[]       @relation("actor")
  blogPosts              BlogPost[]
  passwordResets         PasswordResetToken[]
  itemReports            ItemReport[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use password reset link. Only the SHA-256 of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Page {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  visibility  String   @default("public") // public | private
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelves     Shelf[]

  @@index([userId, position])
  @@index([visibility])
}

model Shelf {
  id         String   @id @default(cuid())
  pageId     String
  name       String
  category   String
  visibility String   @default("public") // public | private
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items      Item[]

  @@index([pageId, position])
  @@index([visibility])
  @@index([category])
}

model Item {
  id            String         @id @default(cuid())
  shelfId       String
  userId        String
  type          String // LINK | PHOTO
  url           String?
  imageUrl      String?
  faviconUrl    String?
  title         String
  description   String         @default("")
  siteName      String?
  tags          String[]       @default([])
  images        String[]       @default([]) // extra photos after the cover (imageUrl)
  visibility    String         @default("public") // public | private
  position      Int            @default(0)
  viewCount     Int            @default(0) // unique views (24h dedupe), owner excluded
  /// Cover photo size in px, so feeds can reserve the right space (filled on upload / lazily).
  imageWidth    Int?
  imageHeight   Int?
  /// Groups "the same thing" across users: a hash of the normalised link URL, else of the normalised title. Copies inherit it.
  canonicalKey  String?
  /// Set when this item was added from someone else's post ("Add to my collection"); points at the original root item.
  sourceItemId  String?
  /// First link the item was posted with; kept when the owner edits the URL (audit trail for scam swaps).
  originalUrl   String?
  /// Set when the owner changed the link after posting ("Link edited").
  urlEditedAt   DateTime?
  /// Link reputation: null = checked clean, "unverified" = the safety check could not run (fail-open).
  linkCheck     String?
  /// Distinct "Report link" reports; at REPORT_HIDE_THRESHOLD the link is gated behind a warning.
  reportCount   Int            @default(0)
  sourceItem    Item?          @relation("ItemCopies", fields: [sourceItemId], references: [id], onDelete: SetNull)
  copies        Item[]         @relation("ItemCopies")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shelf         Shelf          @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         ItemLike[]
  comments      ItemComment[]
  notifications Notification[]
  views         ItemView[]
  blogTags      BlogPostItem[]
  reports       ItemReport[]

  @@index([shelfId, position])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([visibility])
  @@index([canonicalKey, userId])
  @@index([sourceItemId])
}

model ItemReport {
  id         String   @id @default(cuid())
  itemId     String
  reporterId String
  reason     String // scam | malware | spam | other
  createdAt  DateTime @default(now())
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, itemId])
  @@index([itemId])
}

model ItemLike {
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([itemId])
  @@index([createdAt])
}

model ItemComment {
  id            String            @id @default(cuid())
  itemId        String
  userId        String
  body          String
  parentId      String?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  item          Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  parent        ItemComment?      @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ItemComment[]     @relation("replies")
  reactions     CommentReaction[]
  notifications Notification[]

  @@index([itemId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

/// Pending follow, awaiting the target's approval (when their followPolicy is "request").
model FollowRequest {
  requesterId String
  targetId    String
  createdAt   DateTime @default(now())
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User     @relation("requestTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([requesterId, targetId])
  @@index([targetId, createdAt])
}

/// Activity for a user: LIKE | COMMENT | REPLY | FOLLOW | FOLLOW_REQUEST | FOLLOW_ACCEPTED
model Notification {
  id        String       @id @default(cuid())
  userId    String
  actorId   String
  type      String
  itemId    String?
  commentId String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User         @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  item      Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  comment   ItemComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([actorId])
  @@index([itemId])
  @@index([commentId])
}

/// Fixed-window rate limiter state (shared across serverless instances).
model CommentReaction {
  commentId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  comment   ItemComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@index([userId])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @default(now())

  @@index([windowStart])
}

/// Image bytes kept in the database when no Blob store is configured (compact WebP/GIF/ICO only).
model Asset {
  name        String   @id
  contentType String
  data        Bytes
  size        Int
  createdAt   DateTime @default(now())
}

/// One row per (item, viewer); a view counts again only after 24h. viewerKey is a hash (user id or anonymous cookie).
model ItemView {
  itemId       String
  viewerKey    String
  lastViewedAt DateTime @default(now())
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, viewerKey])
  @@index([lastViewedAt])
}

/// Long-form posts (Museo Plus). contentHtml is sanitized on write and again on render.
model BlogPost {
  id          String         @id @default(cuid())
  userId      String
  title       String
  contentHtml String         @default("")
  excerpt     String         @default("")
  coverUrl    String?
  status      String         @default("draft") // draft | published
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       BlogPostItem[]

  @@index([userId, updatedAt])
  @@index([status, publishedAt])
}

/// Items tagged in a blog post (shown on the item's page).
model BlogPostItem {
  postId   String
  itemId   String
  position Int      @default(0)
  post     BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([postId, itemId])
  @@index([itemId])
}
