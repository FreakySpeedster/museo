# ======================================================================
# Shelfie environment variables
# Local dev: copy to .env. Vercel: add these in Project → Settings → Environment Variables.
# ======================================================================

# --- Database (PostgreSQL) — REQUIRED -----------------------------------
# Runtime connection. On serverless use the POOLED url (Neon: the "-pooler" host, Vercel Postgres: POSTGRES_PRISMA_URL / POSTGRES_URL).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shelfie"
# Direct (non-pooled) connection used by `prisma migrate deploy`. Neon: the non-pooler host (POSTGRES_URL_NON_POOLING).
# With no pooler, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shelfie"

# --- App URL ---------------------------------------------------------------
# Public base URL (Stripe redirects, metadata, `Secure` cookie flag when https).
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL), recommended once you have a custom domain.
APP_URL="http://localhost:3000"

# --- File storage ----------------------------------------------------------
# Vercel Blob (recommended on Vercel). Create a Blob store in the Vercel dashboard and connect it to the project:
# this variable is added automatically. When empty, files go to local disk (UPLOAD_DIR), or to the database on Vercel.
BLOB_READ_WRITE_TOKEN=""
# Local-disk fallback only:
UPLOAD_DIR="./uploads"
# Server-side image size limit (MB). NOTE: Vercel caps request bodies at 4.5 MB; the browser downscales large photos
# before upload so 8 MB phone photos still work.
MAX_UPLOAD_MB=8

# --- Stripe (optional) ----------------------------------------------------
# Leave all three empty to use the clearly-labelled "demo mode" upgrade (marks the user as subscribed, no payment).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
# Display text only.
PLUS_PRICE_LABEL="$4 / month"

# --- Link-preview SSRF guard ---------------------------------------------
# Private, loopback, link-local and other reserved ranges are ALWAYS blocked.
# Only set if your network's DNS maps public sites into a reserved range (some sandboxes use 198.18.0.0/15). Leave empty in production.
SSRF_ALLOW_CIDRS=""

# --- Tests / seeding --------------------------------------------------------
# Throwaway database for `npm test` (name must contain "test"; schema is DROPPED on every run).
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shelfie_test"
# Seeding demo accounts (public passwords!) in production is refused unless ALLOW_SEED=1.
# ALLOW_SEED=1

# Sessions need no secret: they are random 256-bit tokens stored hashed in the database.

# --- Operations (optional) ------------------------------------------------
# 16+ chars. Enables POST /api/admin/backfill-thumbnails with "Authorization: Bearer <secret>".
CRON_SECRET=""
# "db" keeps images in the database even outside Vercel.
STORAGE_DRIVER=""
