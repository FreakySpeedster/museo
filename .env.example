# --- Core ---------------------------------------------------------------
# SQLite for local dev. For Postgres: change `provider` in prisma/schema.prisma
# and use e.g. postgresql://user:pass@host:5432/shelfie
DATABASE_URL="file:./dev.db"

# Public base URL of the app (used for Stripe redirects and cookie `secure` flag).
APP_URL="http://localhost:3000"

# --- Uploads --------------------------------------------------------------
# Where uploaded photos and cached link thumbnails are stored (relative to the project root or absolute).
UPLOAD_DIR="./uploads"
# Max upload size in megabytes.
MAX_UPLOAD_MB=8

# --- Stripe (optional) ----------------------------------------------------
# Leave all three empty to use the clearly-labelled "demo mode" upgrade.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# --- Link-preview SSRF guard ---------------------------------------------
# Private, loopback, link-local and other reserved ranges are ALWAYS blocked.
# Only set this if your network's DNS legitimately resolves public sites into a reserved range
# (some sandboxes / egress proxies use 198.18.0.0/15). Comma-separated CIDRs. Leave empty in production.
SSRF_ALLOW_CIDRS=""
